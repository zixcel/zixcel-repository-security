{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zixcel://repository-security/definitions/v1",
  "title": "Definitions compiled into Gitleaks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "zixcel://repository-security/definitions/v1"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,64}$"
              },
              "kind": {
                "const": "literal"
              },
              "category": {
                "enum": [
                  "word",
                  "person",
                  "company",
                  "project"
                ],
                "default": "word"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 256,
                  "pattern": "^[^\\r\\n\\u0000]+$"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "regex"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,64}$"
              },
              "kind": {
                "const": "regex"
              },
              "regex": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "secretGroup": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              },
              "entropy": {
                "type": "number",
                "minimum": 0,
                "maximum": 8
              },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\r\\n\\u0000]+$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
