{
  "repository": "zixcel/zixcel-repository-security",
  "purpose": "Check a source tree for secrets and information that should not be published before sharing it.",
  "responsibility_boundary": "Own the named reusable integration/data mechanism. Product roles/UI and operational approvals stay with consumers; transport/custody reuse managed Crowsi components where capabilities fit. Planning-only APIs must remain clearly distinguished from implemented external operations.",
  "packages": [
    {
      "manifest": "Cargo.toml",
      "package": "zixcel-repository-security",
      "ecosystem": "rust",
      "description": "Bounded local repository inspection with pinned Gitleaks",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [
          "cli",
          "config",
          "definitions",
          "directory",
          "engine",
          "io",
          "maintenance",
          "scanner"
        ],
        "public_reexports": [],
        "implicit_bins": []
      },
      "declared_commands": {}
    }
  ],
  "schema_definitions": [
    "assets/definitions.v1.schema.json"
  ],
  "test_sources": [
    "src/engine.rs",
    "src/io.rs",
    "src/lib.rs",
    "src/main.rs",
    "src/maintenance.rs",
    "src/scanner.rs",
    "tests/directory.rs",
    "tests/gitleaks-pin.json",
    "tests/security.rs"
  ],
  "example_sources": [
