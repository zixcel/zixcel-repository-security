    {
      "path": ".github/workflows/publish-detector.yml",
      "jobs": [
        {
          "job": "verify",
          "condition": "github.repository == 'zixcel/zixcel-repository-security' && github.ref == 'refs/heads/main'",
          "runs_on": "ubuntu-24.04",
          "steps": [
            {
              "name": null,
              "run": null,
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "condition": null
            },
            {
              "name": "Require exact main candidate and all owner validation",
              "run": "set -euo pipefail\n[[ \"$CANDIDATE_RUN\" =~ ^[0-9]+$ && \"$ARCHIVE_SHA\" =~ ^[a-f0-9]{64}$ ]]\ngh api \"repos/$GITHUB_REPOSITORY/actions/runs/$CANDIDATE_RUN\" > \"$RUNNER_TEMP/run.json\"\nbash scripts/verify-candidate-run.sh \"$RUNNER_TEMP/run.json\" \"$GITHUB_SHA\"\nfor workflow in ci.yml oss-policy.yml dependency-policy-tests.yml; do\n  gh api \"repos/$GITHUB_REPOSITORY/actions/workflows/$workflow/runs?head_sha=$GITHUB_SHA&per_page=100\" |\n    jq -e --arg sha \"$GITHUB_SHA\" '[.workflow_runs[] | select(.head_sha==$sha and .head_branch==\"main\" and .event==\"push\")]|sort_by(.run_number)|last|.conclusion==\"success\"'\ndone\nattempt=$(jq -er '.run_attempt' \"$RUNNER_TEMP/run.json\")\ngh run download \"$CANDIDATE_RUN\" --repo \"$GITHUB_REPOSITORY\" --name \"detector-$GITHUB_SHA-$attempt\" --dir \"$RUNNER_TEMP/candidate\"\nbash scripts/verify-engine-candidate.sh \"$RUNNER_TEMP/candidate\" \"$GITHUB_SHA\"\ntest \"$(jq -r '.files[\"gitleaks_8.30.1_hardened_linux_x64.tar.gz\"]' \"$RUNNER_TEMP/candidate/candidate.json\")\" = \"$ARCHIVE_SHA\"\ntag=$(jq -er .tag scripts/gitleaks/component.json)\ngh api \"repos/$GITHUB_REPOSITORY/git/ref/tags/$tag\" |\n  jq -e --arg sha \"$GITHUB_SHA\" '.object.type==\"commit\" and .object.sha==$sha'\n",
              "uses": null,
              "condition": null
            },
            {
              "name": null,
              "run": null,
              "uses": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9",
              "condition": null
            }
          ]
        },
        {
          "job": "publish",
          "condition": null,
          "runs_on": "ubuntu-24.04",
          "steps": [
            {
              "name": null,
              "run": null,
              "uses": "actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333",
              "condition": null
            },
            {
              "name": null,
              "run": null,
              "uses": "actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8",
              "condition": null
            },
            {
              "name": "Publish exact approved bytes once and verify readback",
              "run": "set -euo pipefail\ncd \"$RUNNER_TEMP/candidate\"\narchive=gitleaks_8.30.1_hardened_linux_x64.tar.gz\ntest \"$(sha256sum \"$archive\" | cut -d ' ' -f 1)\" = \"$ARCHIVE_SHA\"\ntag=$(jq -er .releaseTag candidate.json)\n[[ \"$tag\" =~ ^gitleaks/v[0-9]+\\.[0-9]+\\.[0-9]+-r[0-9]+$ ]]\nif gh api \"repos/$GITHUB_REPOSITORY/releases/tags/$tag\" > \"$RUNNER_TEMP/release.json\" 2> \"$RUNNER_TEMP/release-error\"; then\n  jq -e --arg sha \"$GITHUB_SHA\" '.target_commitish==$sha and .draft==false and .prerelease==false' \"$RUNNER_TEMP/release.json\"\nelse\n  grep -q '(HTTP 404)' \"$RUNNER_TEMP/release-error\"\n  test \"$GITHUB_RUN_ATTEMPT\" = 1\n  gh release create \"$tag\" ./* --repo \"$GITHUB_REPOSITORY\" --verify-tag --target \"$GITHUB_SHA\" --title \"Reviewed detector $tag\" --notes \"Detector component only; Linux amd64. Source $GITHUB_SHA; archive SHA256 $ARCHIVE_SHA. Existing production pin is updated through a separate reviewed PR.\"\nfi\ngh release download \"$tag\" --repo \"$GITHUB_REPOSITORY\" --pattern \"$archive\" --dir \"$RUNNER_TEMP/readback\"\ntest \"$(sha256sum \"$RUNNER_TEMP/readback/$archive\" | cut -d ' ' -f 1)\" = \"$ARCHIVE_SHA\"\n",
              "uses": null,
              "condition": null
            }
          ]
        }
      ]
